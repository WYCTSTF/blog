<% if (page.type === 'tags') { %>
  <h1>Tags</h1>
  <ul class="term-list">
  <% site.tags.each(function(tag){ %>
    <li><a href="<%- url_for(tag.path) %>"><%= tag.name %></a> <span class="count"><%= tag.posts.length %></span></li>
  <% }) %>
  </ul>
<% } else if (page.type === 'categories') { %>
  <h1>Categories</h1>
  <ul class="term-list">
  <% site.categories.each(function(category){ %>
    <li><a href="<%- url_for(category.path) %>"><%= category.name %></a> <span class="count"><%= category.posts.length %></span></li>
  <% }) %>
  </ul>
<% } else { %>
  <article class="page">
    <h1><%= page.title %></h1>
    <div class="content"><%- page.content %></div>
  </article>
<% } %>
