<article class="post">
  <header class="post-header">
    <h1><%= page.title %></h1>
    <p class="meta">
      <time datetime="<%- page.date.toISOString() %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (page.categories && page.categories.length) { %>
        · <% page.categories.each(function(c){ %><a href="<%- url_for(c.path) %>"><%= c.name %></a> <% }) %>
      <% } %>
    </p>
  </header>
  <%- page.toc || '' %>
  <div class="content"><%- page.content %></div>
</article>

<nav class="post-nav">
  <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } else { %><span></span><% } %>
  <% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
</nav>

<% var related = related_posts(page); %>
<% if (related.length) { %>
<nav class="related">
  <p class="related-title">Related</p>
  <ul>
  <% related.forEach(function(post){ %>
    <li>
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
      <time datetime="<%- post.date.toISOString() %>"><%= date(post.date, 'YYYY-MM') %></time>
    </li>
  <% }) %>
  </ul>
</nav>
<% } %>
