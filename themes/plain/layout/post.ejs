<article class="post">
  <header class="post-header">
    <h1><%= page.title %></h1>
    <p class="meta">
      <time datetime="<%- page.date.toISOString() %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (page.categories && page.categories.length) { %>
        · <% page.categories.each(function(c){ %><a href="<%- url_for(c.path) %>"><%= c.name %></a> <% }) %>
      <% } %>
      <% if (page.tags && page.tags.length) { %>
        · <% page.tags.each(function(t){ %><a href="<%- url_for(t.path) %>">#<%= t.name %></a> <% }) %>
      <% } %>
    </p>
  </header>
  <div class="content"><%- page.content %></div>
</article>

<nav class="post-nav">
  <% if (page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
  <% if (page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
</nav>
