<% posts.each(function(post){ %>
<article class="post">
  <h2><a href="<%- url_for(post.path) %>"><%= post.title %></a></h2>
  <p class="meta">
    <time datetime="<%- post.date.toISOString() %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
    <% if (post.categories && post.categories.length) { %>
      · <% post.categories.each(function(c){ %><a href="<%- url_for(c.path) %>"><%= c.name %></a> <% }) %>
    <% } %>
  </p>
  <% if (showExcerpt && post.excerpt) { %>
    <div class="excerpt"><%- post.excerpt %></div>
    <p><a href="<%- url_for(post.path) %>">Read more</a></p>
  <% } %>
</article>
<% }) %>
